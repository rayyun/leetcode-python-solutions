# https://leetcode.com/problems/remove-stones-to-minimize-the-total/

# O(n + k⋅log n) / O(n)
import heapq

class Solution:
    def minStoneSum(self, piles: List[int], k: int) -> int:
        heap = [-num for num in piles]
        heapq.heapify(heap)

        for _ in range(k):
            stone = -heapq.heappop(heap)
            remove = stone // 2
            heapq.heappush(heap, -(stone - remove))

        return -sum(heap)
