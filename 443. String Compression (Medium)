# https://leetcode.com/problems/string-compression/description/

# O(n) / O(1)
class Solution:
    def compress(self, chars: List[str]) -> int:
        start = 0
        idx = 0

        while start < len(chars):
            end = start

            while end < len(chars) and chars[start] == chars[end]:
                end += 1
            
            chars[idx] = chars[start]
            idx += 1

            if end - start > 1:
                count = str(end - start)

                for num in count:
                    chars[idx] = num
                    idx += 1

            start = end

        return idx
